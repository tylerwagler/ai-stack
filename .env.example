# AI Stack Environment Configuration
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to git!

# ============================================================================
# Database
# ============================================================================

POSTGRES_DB=postgres
POSTGRES_PASSWORD=          # Generate: openssl rand -base64 32

# ============================================================================
# Supabase Authentication
# ============================================================================

# Anon key - generated from JWT_SECRET, safe for frontend use
# Get from Supabase Studio (http://localhost:8003) > Settings > API after first start
SUPABASE_ANON_KEY=

# ============================================================================
# LLM Inference
# ============================================================================

# Internal auth between llama-proxy and llama-server
LLAMA_API_KEY=              # Generate: echo "sk-ant-$(openssl rand -hex 32)"

# ============================================================================
# GPU Metrics & Monitoring
# ============================================================================

# Auth for temper /metrics endpoint
METRICS_API_KEY=            # Generate: openssl rand -hex 32

# ============================================================================
# Dell iDRAC Fan Control (optional)
# ============================================================================

IDRAC_IP=
IDRAC_USER=
IDRAC_PASS=

# ============================================================================
# Stripe Billing (optional)
# ============================================================================

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
