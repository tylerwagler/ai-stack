#!/bin/bash
# claude-local — Launch Claude Code against a local AI stack
#
# Uses Open WebUI for authentication and LiteLLM (via gateway) for inference.
# All traffic goes through a single port (gateway on :3000).
#
# Install: curl -fsSL https://YOUR-HOST:3000/install/setup.sh | bash
#
# Usage:
#   claude-local [args]                    # Launch Claude Code
#   claude-local --login                   # Login and retrieve/create API key
#   claude-local --set-key <api-key>       # Set API key manually
#   claude-local --set-url <base-url>      # Set base URL
#   claude-local --config                  # Show current config
#   claude-local --update                  # Update this script from the server
#   claude-local --reset-config            # Reset all config
#   claude-local --help                    # Show this help
#   claude-local --version                 # Show version

VERSION="2.1.5"
CONFIG_DIR="$HOME/.config/claude-local"
CONFIG_FILE="$CONFIG_DIR/env"

# --- JSON helpers (jq preferred, python3 fallback) ---
json_get() {
    local json="$1" field="$2"
    if command -v jq &>/dev/null; then
        echo "$json" | jq -r "$field // empty" 2>/dev/null
    else
        echo "$json" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    keys = '${field}'.strip('.').split('.')
    for k in keys:
        d = d[k]
    print(d if d is not None else '')
except: pass" 2>/dev/null
    fi
}

# --- Config management ---
save_config() {
    mkdir -p "$CONFIG_DIR"
    : > "$CONFIG_FILE"
    [ -n "$CLAUDE_LOCAL_API_KEY" ] && echo "CLAUDE_LOCAL_API_KEY=$CLAUDE_LOCAL_API_KEY" >> "$CONFIG_FILE"
    [ -n "$CLAUDE_LOCAL_URL" ] && echo "CLAUDE_LOCAL_URL=$CLAUDE_LOCAL_URL" >> "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

load_config() {
    CLAUDE_LOCAL_API_KEY=""
    CLAUDE_LOCAL_URL=""
    if [ -f "$CONFIG_FILE" ]; then
        while IFS='=' read -r key value; do
            case "$key" in
                CLAUDE_LOCAL_API_KEY) CLAUDE_LOCAL_API_KEY="$value" ;;
                CLAUDE_LOCAL_URL) CLAUDE_LOCAL_URL="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi
}

get_url() {
    echo "${CLAUDE_LOCAL_URL}"
}

ensure_url() {
    if [ -z "$CLAUDE_LOCAL_URL" ]; then
        read -rp "Server URL (e.g. http://10.20.10.5:3000): " CLAUDE_LOCAL_URL
        if [ -z "$CLAUDE_LOCAL_URL" ]; then
            echo "Error: URL is required."
            exit 1
        fi
        # Strip trailing slash
        CLAUDE_LOCAL_URL="${CLAUDE_LOCAL_URL%/}"
        save_config
    fi
}

# --- Open WebUI authentication ---
login_and_get_key() {
    local email="$1" password="$2" base_url="$3"

    # Build JSON payload
    local payload
    if command -v jq &>/dev/null; then
        payload=$(jq -n --arg e "$email" --arg p "$password" '{email:$e, password:$p}')
    else
        local esc_pass="${password//\\/\\\\}"
        esc_pass="${esc_pass//\"/\\\"}"
        payload="{\"email\":\"${email}\",\"password\":\"${esc_pass}\"}"
    fi

    echo "Authenticating with Open WebUI..." >&2

    # Step 1: Sign in to Open WebUI
    local response
    response=$(curl -s -X POST "${base_url}/api/v1/auths/signin" \
        -H "Content-Type: application/json" \
        -d "$payload")

    local token
    token=$(json_get "$response" '.token')

    if [ -z "$token" ]; then
        local error_msg
        error_msg=$(json_get "$response" '.detail')
        [ -z "$error_msg" ] && error_msg="Authentication failed"
        echo "" >&2
        echo "Authentication failed: $error_msg" >&2
        echo "" >&2
        echo "Common issues:" >&2
        echo "  - Wrong email or password" >&2
        echo "  - Account not registered (sign up at ${base_url} first)" >&2
        echo "" >&2
        echo "Or set a key manually: $0 --set-key <your-api-key>" >&2
        return 1
    fi

    echo "Authentication successful! Checking API key..." >&2

    # Step 2: Try to get existing API key
    local key_response
    key_response=$(curl -s "${base_url}/api/v1/auths/api_key" \
        -H "Authorization: Bearer $token")

    local api_key
    api_key=$(json_get "$key_response" '.api_key')

    if [ -n "$api_key" ] && [ "$api_key" != "null" ]; then
        echo "Found existing API key." >&2
        echo "$api_key"
        return 0
    fi

    # Step 3: Create a new API key
    echo "Creating new API key..." >&2
    local create_response
    create_response=$(curl -s -X POST "${base_url}/api/v1/auths/api_key" \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json")

    api_key=$(json_get "$create_response" '.api_key')

    if [ -n "$api_key" ] && [ "$api_key" != "null" ]; then
        echo "API key created successfully." >&2
        echo "$api_key"
        return 0
    fi

    echo "Error: Failed to create API key." >&2
    return 1
}

# --- Load config ---
load_config

# --- Handle commands ---
case "$1" in
    --set-key)
        if [ -z "$2" ]; then
            echo "Error: API key required"
            echo "Usage: $0 --set-key <api-key>"
            exit 1
        fi
        CLAUDE_LOCAL_API_KEY="$2"
        save_config
        echo "API key saved to $CONFIG_FILE"
        exit 0
        ;;
    --set-url)
        if [ -z "$2" ]; then
            echo "Error: Base URL required"
            echo "Usage: $0 --set-url <base-url>"
            echo "Example: $0 --set-url http://10.20.10.5:3000"
            exit 1
        fi
        CLAUDE_LOCAL_URL="${2%/}"
        save_config
        echo "Base URL saved to $CONFIG_FILE"
        exit 0
        ;;
    --config)
        echo "Configuration ($CONFIG_FILE):"
        if [ -n "$CLAUDE_LOCAL_API_KEY" ]; then
            echo "  API Key: ${CLAUDE_LOCAL_API_KEY:0:12}... (set)"
        else
            echo "  API Key: (not set)"
        fi
        echo "  URL: ${CLAUDE_LOCAL_URL:-(not set)}"
        exit 0
        ;;
    --reset-config)
        if [ -f "$CONFIG_FILE" ]; then
            rm "$CONFIG_FILE"
            echo "Configuration reset."
        else
            echo "No configuration file found."
        fi
        exit 0
        ;;
    --update)
        ensure_url
        echo "Updating claude-local from $(get_url)..."
        script_path="$(readlink -f "$0" 2>/dev/null || echo "$0")"
        if curl -fsSL "$(get_url)/install/claude-local" -o "$script_path"; then
            chmod +x "$script_path"
            echo "Updated successfully."
        else
            echo "Update failed."
            exit 1
        fi
        exit 0
        ;;
    --login)
        ensure_url
        echo "Login to AI Stack"
        echo ""

        read -rp "Email: " email
        if [ -z "$email" ]; then
            echo "Error: Email required"
            exit 1
        fi

        read -rsp "Password: " password
        echo
        if [ -z "$password" ]; then
            echo "Error: Password required"
            exit 1
        fi

        retrieved_key=$(login_and_get_key "$email" "$password" "$(get_url)")

        if [ $? -eq 0 ] && [ -n "$retrieved_key" ]; then
            CLAUDE_LOCAL_API_KEY="$retrieved_key"
            save_config
            echo ""
            echo "API key configured successfully!"
            echo "  Config saved to: $CONFIG_FILE"
            echo ""
            echo "Run 'claude-local' to start Claude Code."
        else
            echo "Failed to retrieve or create API key."
            exit 1
        fi
        exit 0
        ;;
    --help|-h)
        echo "claude-local v${VERSION} — Launch Claude Code with local AI inference"
        echo ""
        echo "Usage: $0 [options] [claude-args...]"
        echo ""
        echo "Options:"
        echo "  --login              Login to Open WebUI and save API key"
        echo "  --set-key <key>      Set API key manually"
        echo "  --set-url <url>      Set gateway URL"
        echo "  --config             Show current configuration"
        echo "  --update             Update this script from the server"
        echo "  --reset-config       Delete saved configuration"
        echo "  --help, -h           Show this help"
        echo "  --version            Show version"
        echo ""
        echo "All other arguments are passed through to Claude Code."
        echo "If no --model is specified, you'll be prompted to choose one."
        exit 0
        ;;
    --version)
        echo "claude-local v${VERSION}"
        exit 0
        ;;
esac

# --- Ensure URL is set ---
ensure_url

# --- Auto-update ---
if [ "${CLAUDE_LOCAL_SKIP_UPDATE:-}" != "1" ]; then
    remote_version=$(curl -fsSL --connect-timeout 3 --max-time 5 \
        "$(get_url)/install/version" 2>/dev/null | tr -d '[:space:]')
    if [ -n "$remote_version" ] && [ "$remote_version" != "$VERSION" ]; then
        echo "Updating claude-local ($VERSION -> $remote_version)..." >&2
        script_path="$(readlink -f "$0" 2>/dev/null || echo "$0")"
        if curl -fsSL "$(get_url)/install/claude-local" -o "${script_path}.tmp" 2>/dev/null \
                && [ -s "${script_path}.tmp" ]; then
            mv "${script_path}.tmp" "$script_path"
            chmod +x "$script_path"
            echo "Updated. Restarting..." >&2
            export CLAUDE_LOCAL_SKIP_UPDATE=1
            exec "$script_path" "$@"
        else
            rm -f "${script_path}.tmp"
            echo "Auto-update failed, continuing with current version." >&2
        fi
    fi
fi

echo "claude-local v${VERSION}" >&2

# --- Ensure we have an API key ---
if [ -z "$CLAUDE_LOCAL_API_KEY" ]; then
    echo ""
    echo "Welcome to Claude Local!"
    echo ""
    echo "No API key found. You need to authenticate first."
    echo ""
    read -rp "Would you like to log in now? (y/n): " -n 1
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo ""
        read -rp "Email: " email
        if [ -z "$email" ]; then
            echo "Error: Email required"
            exit 1
        fi

        read -rsp "Password: " password
        echo ""

        retrieved_key=$(login_and_get_key "$email" "$password" "$(get_url)")

        if [ $? -eq 0 ] && [ -n "$retrieved_key" ]; then
            CLAUDE_LOCAL_API_KEY="$retrieved_key"
            save_config
            echo ""
            echo "API key configured! Continuing..."
            echo ""
        else
            echo ""
            echo "You can try again or set a key manually:"
            echo "  $0 --login"
            echo "  $0 --set-key <key>"
            exit 1
        fi
    else
        echo ""
        echo "Set up later with:"
        echo "  $0 --login"
        echo "  $0 --set-key <key>"
        exit 1
    fi
fi

if [ -z "$CLAUDE_LOCAL_API_KEY" ]; then
    echo "Error: No API key. Run: $0 --login"
    exit 1
fi

# --- Validate API key ---
BASE_URL="$(get_url)"
echo "Validating API key..." >&2
validation_response=$(curl -s -w "\n%{http_code}" \
    -H "x-api-key: $CLAUDE_LOCAL_API_KEY" \
    "${BASE_URL}/v1/models" 2>/dev/null)
http_code=$(echo "$validation_response" | tail -n1)

if [ "$http_code" = "401" ] || [ "$http_code" = "403" ]; then
    echo "" >&2
    echo "API key validation failed (HTTP $http_code)" >&2
    echo "" >&2

    read -rp "Would you like to log in to get a new key? (y/n): " -n 1 >&2
    echo "" >&2

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "" >&2
        read -rp "Email: " email >&2
        if [ -z "$email" ]; then
            echo "Error: Email required" >&2
            exit 1
        fi

        read -rsp "Password: " password >&2
        echo "" >&2

        retrieved_key=$(login_and_get_key "$email" "$password" "$BASE_URL")

        if [ $? -eq 0 ] && [ -n "$retrieved_key" ]; then
            CLAUDE_LOCAL_API_KEY="$retrieved_key"
            save_config
            echo "" >&2
            echo "API key configured! Continuing..." >&2
            echo "" >&2
        else
            exit 1
        fi
    else
        exit 1
    fi
elif [ "$http_code" != "200" ]; then
    echo "" >&2
    echo "Warning: Could not validate API key (HTTP $http_code)" >&2
    echo "Server may not be reachable at: ${BASE_URL}" >&2
    echo "Continuing anyway..." >&2
    echo "" >&2
    sleep 2
else
    echo "API key valid" >&2
fi

# --- Set environment for Claude Code ---
unset ANTHROPIC_API_KEY 2>/dev/null
export ANTHROPIC_AUTH_TOKEN="$CLAUDE_LOCAL_API_KEY"
export ANTHROPIC_BASE_URL="${BASE_URL}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# --- Default model ---
has_model=false
for arg in "$@"; do
    if [[ "$arg" == "--model" ]]; then
        has_model=true
        break
    fi
done

if [ "$has_model" = false ]; then
    set -- "--model" "Qwen3 Coder Next" "$@"
fi

# --- Launch Claude Code ---
exec claude "$@"
