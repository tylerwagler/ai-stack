#!/bin/bash
# claude-local — Local development wrapper for Claude Code
#
# This version is for development use when running on the AI Stack host.
# For distributable installs, use: curl -fsSL http://ellie:3000/install/setup.sh | bash
#
# Usage:
#   ./claude-local [args]
#   ./claude-local --login                 # Login and retrieve/create API key
#   ./claude-local --set-key <api-key>     # Set API key manually
#   ./claude-local --set-url <base-url>    # Set base URL
#   ./claude-local --config                # Show current config

CONFIG_DIR="$HOME/.config/claude-local"
CONFIG_FILE="$CONFIG_DIR/env"

# Default Configuration
DEFAULT_AI_STACK_HOST="ellie"
DEFAULT_AI_STACK_IP="10.20.10.5"

# --- JSON helpers (jq preferred, python3 fallback) ---
json_get() {
    local json="$1" field="$2"
    if command -v jq &> /dev/null; then
        echo "$json" | jq -r "$field // empty" 2>/dev/null
    else
        echo "$json" | python3 -c "import sys,json; d=json.load(sys.stdin); v=$field; print(v if v is not None else '')" 2>/dev/null
    fi
}

json_get_py() {
    local json="$1" jq_expr="$2" py_expr="$3"
    if command -v jq &> /dev/null; then
        echo "$json" | jq -r "$jq_expr" 2>/dev/null
    else
        echo "$json" | python3 -c "import sys,json; data=json.load(sys.stdin); $py_expr" 2>/dev/null
    fi
}

# Helper function to save config
save_config() {
    mkdir -p "$CONFIG_DIR"
    {
        [ -n "$CLAUDE_LOCAL_API_KEY" ] && echo "CLAUDE_LOCAL_API_KEY=$CLAUDE_LOCAL_API_KEY"
        [ -n "$CLAUDE_LOCAL_URL" ] && echo "CLAUDE_LOCAL_URL=$CLAUDE_LOCAL_URL"
    } > "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
}

# Helper function to authenticate via ai-proxy auth endpoints
login_and_get_key() {
    local email="$1"
    local password="$2"
    local base_url="$3"

    # Build JSON payload
    local json_payload
    if command -v jq &> /dev/null; then
        json_payload=$(jq -n --arg e "$email" --arg p "$password" '{email:$e, password:$p}')
    else
        local esc_pass="${password//\\/\\\\}"
        esc_pass="${esc_pass//\"/\\\"}"
        json_payload="{\"email\":\"${email}\",\"password\":\"${esc_pass}\"}"
    fi

    echo "Authenticating with AI Stack..." >&2

    local response
    response=$(curl -s -X POST "${base_url}/v1/auth/login" \
        -H "Content-Type: application/json" \
        -d "$json_payload")

    local access_token
    access_token=$(json_get "$response" '.access_token')

    if [ -z "$access_token" ]; then
        local error_msg
        error_msg=$(json_get_py "$response" '.error.message // .msg // "Authentication failed"' \
            "e=data.get('error',{}); print(e.get('message','') if isinstance(e,dict) else data.get('msg','Authentication failed'))")
        echo "" >&2
        echo "Authentication failed: $error_msg" >&2
        echo "" >&2
        echo "Common issues:" >&2
        echo "  - Wrong password" >&2
        echo "  - Email not registered (sign up at http://localhost:3000 first)" >&2
        echo "  - Email not confirmed" >&2
        echo "" >&2
        echo "Or use manual setup: $0 --set-key <your-api-key>" >&2
        return 1
    fi

    echo "Authentication successful! Checking API keys..." >&2

    # Check for existing keys in login response
    local key_count
    key_count=$(json_get_py "$response" '.api_keys | length' \
        "print(len(data.get('api_keys',[])))")

    if [ "$key_count" -gt 0 ] 2>/dev/null; then
        echo "Found $key_count existing API key(s):" >&2
        json_get_py "$response" \
            '(.api_keys | to_entries[] | "  \(.key+1). \(.value.name) (created: \(.value.created_at[:10]))")' \
            "
for i,k in enumerate(data.get('api_keys',[]),1):
    print(f\"  {i}. {k.get('name','Unnamed')} (created: {str(k.get('created_at',''))[:10]})\")" >&2

        echo "" >&2
        echo "Select a key to use (1-${key_count}), or press Enter to create a new one:" >&2
        read -r selection

        if [ -n "$selection" ] && [ "$selection" -ge 1 ] && [ "$selection" -le "$key_count" ] 2>/dev/null; then
            local selected_key
            selected_key=$(json_get_py "$response" \
                ".api_keys[$((selection-1))].api_key" \
                "print(data['api_keys'][$((selection-1))]['api_key'])")
            echo "Using existing API key." >&2
            echo "$selected_key"
            return 0
        fi
    fi

    # Create new API key via auth endpoint
    echo "Creating new API key..." >&2
    local create_resp
    create_resp=$(curl -s -X POST "${base_url}/v1/auth/keys" \
        -H "Authorization: Bearer $access_token" \
        -H "Content-Type: application/json" \
        -d "{\"name\":\"claude-local-$(date +%Y%m%d-%H%M%S)\"}")

    local new_key
    new_key=$(json_get "$create_resp" '.api_key')

    if [ -z "$new_key" ]; then
        echo "Error: Failed to create API key" >&2
        return 1
    fi

    local key_name
    key_name=$(json_get "$create_resp" '.name')
    echo "Successfully created new API key: $key_name" >&2
    echo "$new_key"
    return 0
}

# Load saved configuration
CLAUDE_LOCAL_API_KEY=""
CLAUDE_LOCAL_URL=""
if [ -f "$CONFIG_FILE" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            CLAUDE_LOCAL_API_KEY) CLAUDE_LOCAL_API_KEY="$value" ;;
            CLAUDE_LOCAL_URL) CLAUDE_LOCAL_URL="$value" ;;
        esac
    done < "$CONFIG_FILE"
fi

# Set defaults if not configured
AI_STACK_HOST="${AI_STACK_HOST:-$DEFAULT_AI_STACK_HOST}"
AI_STACK_IP="${AI_STACK_IP:-$DEFAULT_AI_STACK_IP}"

# Handle configuration commands
case "$1" in
    --set-key)
        if [ -z "$2" ]; then
            echo "Error: API key required"
            echo "Usage: $0 --set-key <api-key>"
            exit 1
        fi
        CLAUDE_LOCAL_API_KEY="$2"
        save_config
        echo "API key saved to $CONFIG_FILE"
        exit 0
        ;;
    --set-url)
        if [ -z "$2" ]; then
            echo "Error: Base URL required"
            echo "Usage: $0 --set-url <base-url>"
            echo "Example: $0 --set-url http://10.20.10.5:8081"
            exit 1
        fi
        CLAUDE_LOCAL_URL="$2"
        save_config
        echo "Base URL saved to $CONFIG_FILE"
        exit 0
        ;;
    --config)
        echo "Current configuration ($CONFIG_FILE):"
        if [ -n "$CLAUDE_LOCAL_API_KEY" ]; then
            echo "  API Key: ${CLAUDE_LOCAL_API_KEY:0:10}... (set)"
        else
            echo "  API Key: (not set)"
        fi
        echo "  URL: ${CLAUDE_LOCAL_URL:-(auto-detect)}"
        exit 0
        ;;
    --reset-config)
        if [ -f "$CONFIG_FILE" ]; then
            rm "$CONFIG_FILE"
            echo "Configuration reset. File removed: $CONFIG_FILE"
        else
            echo "No configuration file found."
        fi
        exit 0
        ;;
    --login)
        echo "Login to AI Stack"
        echo ""

        read -p "Email: " email
        if [ -z "$email" ]; then
            echo "Error: Email required"
            exit 1
        fi

        read -sp "Password: " password
        echo
        if [ -z "$password" ]; then
            echo "Error: Password required"
            exit 1
        fi

        # Discover base URL for auth
        if [ -n "$CLAUDE_LOCAL_URL" ]; then
            auth_url="$CLAUDE_LOCAL_URL"
        elif [[ "$(hostname)" == "$AI_STACK_HOST" ]]; then
            auth_url="http://localhost:8081"
        else
            auth_url="http://${AI_STACK_IP}:8081"
        fi

        retrieved_key=$(login_and_get_key "$email" "$password" "$auth_url")

        if [ $? -eq 0 ] && [ -n "$retrieved_key" ]; then
            CLAUDE_LOCAL_API_KEY="$retrieved_key"
            save_config
            echo ""
            echo "API key configured successfully!"
            echo "  Config saved to: $CONFIG_FILE"
            echo ""
            echo "You can now use: $0 \"Your prompt\""
        else
            echo "Failed to retrieve or create API key."
            exit 1
        fi
        exit 0
        ;;
esac

# Discover the correct base URL if not manually set
if [ -z "$CLAUDE_LOCAL_URL" ]; then
    if [[ "$(hostname)" == "$AI_STACK_HOST" ]]; then
        CLAUDE_LOCAL_URL="http://localhost:8081"
    else
        if ping -c 1 -W 1 "$AI_STACK_IP" > /dev/null 2>&1; then
            CLAUDE_LOCAL_URL="http://${AI_STACK_IP}:8081"
        else
            CLAUDE_LOCAL_URL="http://${AI_STACK_HOST}.local:8081"
        fi
    fi
fi

# Load API Key from config, or try local .env (dev environment)
if [ -z "$CLAUDE_LOCAL_API_KEY" ]; then
    SEARCH_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    for dir in "$SEARCH_PATH" "$(dirname "$SEARCH_PATH")" "/home/tyler/ai-stack"; do
        if [ -f "$dir/.env" ]; then
            CLAUDE_LOCAL_API_KEY=$(grep "^LLAMA_API_KEY=" "$dir/.env" | cut -d= -f2- | tr -d "[:space:]")
            if [ -n "$CLAUDE_LOCAL_API_KEY" ]; then
                break
            fi
        fi
    done
fi

# Prompt and Save if missing
if [ -z "$CLAUDE_LOCAL_API_KEY" ]; then
    echo ""
    echo "Welcome to Claude Local!"
    echo ""
    echo "No API key found. To use Claude Code with your local AI Stack,"
    echo "you'll need to authenticate and retrieve your API key."
    echo ""
    read -p "Would you like to log in now? (y/n): " -n 1 -r
    echo ""

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo ""
        echo "Starting login process..."
        echo ""

        read -p "Email: " email
        if [ -z "$email" ]; then
            echo "Error: Email required"
            exit 1
        fi

        read -sp "Password: " password
        echo ""

        retrieved_key=$(login_and_get_key "$email" "$password" "$CLAUDE_LOCAL_URL")

        if [ $? -eq 0 ] && [ -n "$retrieved_key" ]; then
            CLAUDE_LOCAL_API_KEY="$retrieved_key"
            save_config
            echo ""
            echo "API key configured successfully!"
            echo ""
            echo "You're all set! Continuing with Claude Code..."
            echo ""
        else
            echo ""
            echo "Failed to retrieve API key."
            echo ""
            echo "You can try again or set a key manually:"
            echo "  $0              # Try again"
            echo "  $0 --set-key <key>  # Set manually"
            echo ""
            exit 1
        fi
    else
        echo ""
        echo "No problem! You can authenticate later using:"
        echo "  $0 --login         # Login to get a key"
        echo "  $0 --set-key <key>  # Set a key manually"
        echo ""
        exit 1
    fi
fi

if [ -z "$CLAUDE_LOCAL_API_KEY" ]; then
    echo "Error: No API key found. Please set it with: $0 --set-key <key>"
    exit 1
fi

# Validate API key before launching Claude
echo "Validating API key..." >&2
validation_response=$(curl -s -w "\n%{http_code}" -H "Authorization: Bearer $CLAUDE_LOCAL_API_KEY" "${CLAUDE_LOCAL_URL}/v1/models" 2>/dev/null)
http_code=$(echo "$validation_response" | tail -n1)

if [ "$http_code" = "401" ] || [ "$http_code" = "403" ]; then
    echo "" >&2
    echo "API key validation failed: Invalid or expired key" >&2
    echo "" >&2

    read -p "Would you like to log in now to get a valid key? (y/n): " -n 1 -r >&2
    echo "" >&2

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "" >&2
        read -p "Email: " email >&2
        if [ -z "$email" ]; then
            echo "Error: Email required" >&2
            exit 1
        fi

        read -sp "Password: " password >&2
        echo "" >&2

        retrieved_key=$(login_and_get_key "$email" "$password" "$CLAUDE_LOCAL_URL")

        if [ $? -eq 0 ] && [ -n "$retrieved_key" ]; then
            CLAUDE_LOCAL_API_KEY="$retrieved_key"
            save_config
            echo "" >&2
            echo "API key configured! Continuing..." >&2
            echo "" >&2
        else
            exit 1
        fi
    else
        exit 1
    fi
elif [ "$http_code" != "200" ]; then
    echo "" >&2
    echo "Warning: Could not validate API key (HTTP $http_code)" >&2
    echo "The AI Stack may not be reachable at: ${CLAUDE_LOCAL_URL}" >&2
    echo "" >&2
    echo "Continuing anyway..." >&2
    sleep 2
else
    echo "API key valid" >&2
fi

export ANTHROPIC_API_KEY="$CLAUDE_LOCAL_API_KEY"
export ANTHROPIC_BASE_URL="$CLAUDE_LOCAL_URL"

# Disable non-essential traffic
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Check for model argument or special commands
has_model=false
for arg in "$@"; do
    if [[ "$arg" == "--model" ]] || [[ "$arg" == "--help" ]] || [[ "$arg" == "-h" ]] || [[ "$arg" == "--version" ]] || [[ "$arg" == "-v" ]]; then
        has_model=true
        break
    fi
done

# If no model provided, fetch available ones and prompt
if [ "$has_model" = false ]; then
    echo "Fetching available models from local stack..."
    # Use public chat-models endpoint (no auth needed)
    models_raw=$(curl -s --connect-timeout 2 --max-time 10 \
        "${CLAUDE_LOCAL_URL}/model/chat-models" 2>/dev/null)

    model_data=$(json_get_py "$models_raw" \
        '.[] | "\(.id)\t\(.alias // .id)\t\(if .is_local then "Ellie" else "Sparky" end)"' \
        "
for m in (data if isinstance(data, list) else []):
    alias = m.get('alias') or m.get('id','?')
    host = 'Ellie' if m.get('is_local') else 'Sparky'
    print(f\"{m.get('id','')}\t{alias}\t{host}\")")

    if [ -z "$model_data" ]; then
        echo "Error: Could not connect to AI Stack at ${CLAUDE_LOCAL_URL}."
        exit 1
    fi

    mapfile -t model_lines <<< "$model_data"

    if [ ${#model_lines[@]} -eq 1 ]; then
        model_id=$(echo "${model_lines[0]}" | cut -f1)
        model_label=$(echo "${model_lines[0]}" | cut -f2)
        model_host=$(echo "${model_lines[0]}" | cut -f3)
        echo "Using model: $model_label ($model_host)"
        set -- "$@" "--model" "$model_id"
    else
        echo "Select a model to use:"
        display_labels=()
        model_ids=()
        for line in "${model_lines[@]}"; do
            mid=$(echo "$line" | cut -f1)
            mlabel=$(echo "$line" | cut -f2)
            mhost=$(echo "$line" | cut -f3)
            display_labels+=("$mlabel ($mhost)")
            model_ids+=("$mid")
        done
        select model_choice in "${display_labels[@]}"; do
            if [ -n "$model_choice" ]; then
                idx=$((REPLY - 1))
                set -- "$@" "--model" "${model_ids[$idx]}"
                echo "Using model: $model_choice"
                break
            fi
        done
    fi
fi

# Run Claude Code
exec claude "$@"
